{
  "name": "jobboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node e2e/smoke.js",
    "test:e2e": "node e2e/full.js",
    "supabase:deploy": "node scripts/deploy-edge-functions.js",
    "supabase:deploy:all": "node scripts/deploy-edge-functions.js",
    "supabase:migrate": "node scripts/push-migrations.js",
    "e2e:smoke": "npm run test:smoke",
    "e2e:full": "npm run test:e2e",
    "e2e": "npm run test:smoke && npm run test:e2e",
    "vercel:link": "npx --yes vercel@latest link",
    "vercel:env": "npx --yes vercel@latest env pull .env.vercel.pull.tmp --environment=development --yes && node scripts/merge-vercel-env.cjs .env.vercel.pull.tmp && rm -f .env.vercel.pull.tmp && node scripts/sync-branch-environment.js",
    "env:sync": "node scripts/sync-branch-environment.js",
    "codegen:types": "node scripts/codegen-supabase-types.mjs",
    "codegen:zod": "supazod -i src/types/database.ts -o src/types/database.zod.ts -I -s public && node scripts/patch-database-zod-json.mjs",
    "codegen": "npm run codegen:types && npm run codegen:zod",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@flags-sdk/vercel": "^1.4.7",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@radix-ui/react-slot": "^1.3.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-underline": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@vercel/toolbar": "^0.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flags": "^4.3.0",
    "framer-motion": "^13.1.1",
    "next": "16.3.3",
    "puppeteer": "^25.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.25.0",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "supabase": "^2.116.0",
    "supazod": "^4.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
