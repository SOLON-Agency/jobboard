# Deploy URL: https://jobboard-sand.vercel.app/
# See docs/ENVIRONMENTS.md

# ── Required ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://uccivcdtfpevtykirkuw.supabase.co

# Dashboard → Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key

# Dashboard → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=your-test-db-password

# ── TEST browser title prefix (Preview + local branch test) ───────────────────
NEXT_PUBLIC_TITLE_PREFIX=[TEST]

# ── Optional — override when testing auth redirects against sandbox URL ───────
# NEXT_PUBLIC_SITE_URL=https://jobboard-sand.vercel.app/
