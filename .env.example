# Environment files — copy the three templates below (do not commit the filled copies).
# Full guide: docs/ENVIRONMENTS.md

#   cp .env.local.example .env.local   # shared CLI token + Development flags
#   cp .env.test.example   .env.test     # TEST Supabase (branch `test`)
#   cp .env.prod.example   .env.prod     # PROD Supabase (branch `main`)
#   npm run env:sync                     # composes → .env for Next.js + scripts

# Committed templates:
#   .env.local.example
#   .env.test.example
#   .env.prod.example
