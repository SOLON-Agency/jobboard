# Copy to `.env.local` — shared secrets for local development (all branches).
# Do not commit `.env.local`.
# Branch-specific Supabase keys live in `.env.test` / `.env.prod`.
# See docs/ENVIRONMENTS.md

# ── Local site URL (always localhost when running npm run dev) ────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase CLI (same personal token for both projects) ──────────────────────
# Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx

# ── Vercel Flags — Development scope (npm run vercel:env after vercel link) ───
FLAGS=
FLAGS_SECRET=

# ── Web Push (optional — Dashboard → Supabase → Edge secrets for prod) ───────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── E2E tests (optional) ────────────────────────────────────────────────────
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=

# ── Local reference only — Edge Functions use Supabase secrets in cloud ───────
# RESEND_API_KEY=
# RESEND_FROM="JurisJobs <reply@email.jurisjobs.ro>"
