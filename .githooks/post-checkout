#!/bin/sh
#
# After switching branches: re-compose `.env` for TEST vs PROD Supabase + title prefix.
#
# Git passes: $1 = previous HEAD, $2 = new HEAD, $3 = 1 (branch checkout) | 0 (file checkout)
#
# Opt-out: SKIP_ENV_SYNC=1
#
set -e

if [ "${3:-0}" != "1" ]; then
  exit 0
fi

if [ "${SKIP_ENV_SYNC:-0}" = "1" ]; then
  echo "⚠️  SKIP_ENV_SYNC=1 — skipping post-checkout env sync."
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo ""
echo "🌿  post-checkout: syncing .env to current git branch..."
echo ""

node scripts/sync-branch-environment.js || true

exit 0
